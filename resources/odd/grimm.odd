<?xml-model href="teipublisher_odds.xsd"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xmlns:pb="http://teipublisher.com/1.0" xml:lang="en">
    <teiHeader>
        <fileDesc>
            <titleStmt>
                <title>Grimm’s Fairy Tales</title>
            </titleStmt>
            <publicationStmt>
                <publisher>eXistSolutions GmbH</publisher>
                <availability>
                    <licence target="https://www.gnu.org/licenses/gpl-3.0.en.html">Distributed under GNU General Public License</licence>
                    <p>Copyright 2017 <ref target="http://existsolutions.com">eXistSolutions GmbH</ref>
                    </p>
                    <p>This program is free software: you can redistribute it and/or modify
                        it under the terms of the GNU General Public License as published by
                        the Free Software Foundation, either version 3 of the License, or
                        (at your option) any later version.</p>
                    <p>This program is distributed in the hope that it will be useful,
                        but WITHOUT ANY WARRANTY; without even the implied warranty of
                        MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
                        GNU General Public License for more details.</p>
                </availability>
            </publicationStmt>
            <sourceDesc>
                <p>Generated by <ref target="http://tei-publisher.com">TEI Publisher</ref>
                </p>
                <p>born digital</p>
            </sourceDesc>
        </fileDesc>
        <encodingDesc>
            <tagsDecl>
                <rendition source="grimm.css"/>
            </tagsDecl>
        </encodingDesc>
        <revisionDesc>
            <change when="2024-04-02+02:00">Initial version</change>
        </revisionDesc>
    </teiHeader>
    <text>
        <body>
            <schemaSpec start="TEI teiCorpus" ident="grimm" source="teipublisher.odd"> <elementSpec ident="title" mode="change">
                    <model predicate="$parameters?view='tale'" behaviour="heading">
            <param name="level" value="3"/>
            <param name="content" value="ext-html:get-title(., $parameters?tale)"/>
        </model>
                    <model predicate="$parameters?header='short'" behaviour="heading">
            <param name="level" value="4"/>
        </model>
                    <modelSequence predicate="parent::titleStmt/parent::fileDesc">
            <model predicate="preceding-sibling::title" behaviour="text">
                <param name="content" value="' — '"/>
            </model>
            <model behaviour="inline"/>
        </modelSequence>
                    <model predicate="not(@level) and parent::bibl" behaviour="inline"/>
                    <modelSequence predicate="@level='m' or not(@level)">
            <model behaviour="inline">
                <outputRendition xml:space="preserve">
                font-style: italic;
                </outputRendition>
            </model>
            <model predicate="ancestor::biblFull" behaviour="text">
                <param name="content" value="', '"/>
            </model>
        </modelSequence>
                    <modelSequence predicate="@level='s' or @level='j'">
            <model behaviour="inline">
                <outputRendition xml:space="preserve">
                font-style: italic;
                </outputRendition>
            </model>
            <model predicate="following-sibling::* and     (  ancestor::biblFull)" behaviour="text">
                <param name="content" value="', '"/>
            </model>
        </modelSequence>
                    <modelSequence predicate="@level='u' or @level='a'">
            <model behaviour="inline">
                <outputRendition xml:space="preserve">
                font-style: italic;
                </outputRendition>
            </model>
            <model predicate="following-sibling::* and     (    ancestor::biblFull)" behaviour="text">
                <param name="content" value="'. '"/>
            </model>
        </modelSequence>
                    <model behaviour="inline">
            <outputRendition xml:space="preserve">
            font-style: italic;
            </outputRendition>
        </model>
                </elementSpec>
                <elementSpec ident="titleStmt" mode="change">
                    <modelSequence predicate="$parameters?view='tale'">
            <model behaviour="graphic" cssClass="thumbnail">
                <param name="title" value="'Illustration for tale ' || title[1]/string()"/>
                <param name="url" value="ext-html:get-thumbnail($parameters?tale)"/>
            </model>
            <model behaviour="link">
                <param name="content" value="title[1]"/>
                <param name="uri" value="$parameters?doc"/>
            </model>
        </modelSequence>
                    <model output="latex" behaviour="meta">
            <param name="content" value="."/>
        </model>
                    <model output="fo" behaviour="heading"/>
                    <model predicate="$parameters?mode='title'" behaviour="heading">
            <param name="content" value="title[not(@type)]"/>
            <param name="level" value="5"/>
        </model>
                    <modelSequence output="web" predicate="$parameters?header='short'">
            <model behaviour="link">
                <param name="content" value="(../descendant::sourceDesc/descendant::title[@type eq 'alt'], title[1])"/>
                <param name="uri" value="$parameters?doc"/>
            </model>
        </modelSequence>
                    <model output="web" behaviour="block"/>
                </elementSpec>
                <elementSpec ident="fileDesc" mode="change">
                    <modelSequence predicate="$parameters?header='short'">
            <model behaviour="block" cssClass="header-short">
                <param name="content" value="titleStmt"/>
            </model>
            <model behaviour="block" cssClass="header-short">
                <param name="content" value="sourceDesc"/>
            </model>
            <model behaviour="block" cssClass="header-short">
                <param name="content" value="../profileDesc//origDate/string()"/>
            </model>
        </modelSequence>
                    <model behaviour="title">
            <param name="content" value="titleStmt"/>
        </model>
                </elementSpec>
                <elementSpec ident="sourceDesc" mode="add">
                    <model predicate="$parameters?header='short' and (string-length(descendant::editor[@role eq 'translator']/text()[1]) gt 1)" behaviour="inline">
            <param name="content" value="descendant::editor[@role eq 'translator']/text()[1]/normalize-space(.)"/>
        </model>
                </elementSpec>
                <elementSpec ident="pb" mode="change">
                    <model predicate="@facs" behaviour="webcomponent">
            <desc>Use the url from the facs attribute to link with IIIF image</desc>
            <param name="name" value="'pb-facs-link'"/>
            <param name="facs" value="@facs"/>
            <param name="label" value="@n"/>
            <param name="emit" value="'transcription'"/>
        </model>
                    <model predicate="starts-with(@facs, 'iiif:')" behaviour="webcomponent">
            <desc>If facs attribute starts with iiif prefix, use the trailing part as a link to the IIIF image</desc>
            <param name="name" value="'pb-facs-link'"/>
            <param name="facs" value="replace(@facs, '^iiif:(.*)$', '$1')"/>
            <param name="label" value="'Page'"/>
            <param name="emit" value="'transcription'"/>
        </model>
                    <model predicate="not(@n)" behaviour="omit" useSourceRendition="true"/>
                </elementSpec>
                <elementSpec ident="seg" mode="change">
                    <model predicate="not(@corresp) and not(@type)" behaviour="inline">
            <outputRendition xml:space="preserve">
            color: gray;
            </outputRendition>
        </model>
                    <modelSequence predicate="@corresp or (@type eq 'base')">
            <model behaviour="pass-through">
                <desc>Creates span elements for sync on click</desc>
                <param name="content" value="."/>
                <param name="key" value="if (@corresp) then @corresp else @xml:id"/>
                <pb:template xmlns="" xml:space="preserve"><span class="syncSpan hide" data-ref="[[key]]" onclick="highlightSeg(this)">[[content]]</span></pb:template>
            </model>
            <model behaviour="pass-through" useSourceRendition="true">
                <desc>Creates pb-highlight elements</desc>
                <param name="content" value="."/>
                <param name="key" value="if (@corresp) then @corresp else @xml:id"/>
                <pb:template xmlns="" xml:space="preserve"><pb-highlight highlight-self="true" key="[[key]]" scroll="true" disabled="true">[[content]]</pb-highlight></pb:template>
            </model>
        </modelSequence>
                </elementSpec>
            <elementSpec ident="body" mode="change">
                    <model behaviour="block">
            <outputRendition xml:space="preserve">
            
            
            
            
            
            
            
            
            padding-right: 1em;
height: 75vh;
overflow-y: auto;
            
            
            
            
            
            
            
            
            </outputRendition>
        </model>
                </elementSpec>
                <elementSpec ident="teiHeader" mode="change">
                    <modelSequence predicate="$parameters?header='metadata'">
            <model behaviour="heading">
                <param name="content" value="let $titleStmt := descendant::titleStmt return   (&lt;em&gt;{$titleStmt/title/string()}&lt;/em&gt;, ' by ', $titleStmt/author/string())"/>
                <param name="level" value="3"/>
            </model>
            <model behaviour="pass-through">
                <param name="content" value="let $bibl:= descendant::sourceDesc/bibl return string-join(($bibl/publisher, $bibl/date), ', ')"/>
                <pb:template xmlns="" xml:space="preserve"><p class="metadata-p"><strong><pb-i18n key="edition.source">Source edition</pb-i18n></strong>: [[content]]</p></pb:template>
            </model>
            <model predicate="descendant::sourceDesc/bibl/editor[@role eq 'translator']/text()[1]/matches(., '[A-Za-z]')" behaviour="pass-through">
                <param name="translators" value="descendant::sourceDesc/bibl/editor[@role eq 'translator']/text()[1]/replace(., '\s+$', '')"/>
                <pb:template xmlns="" xml:space="preserve"><p class="metadata-p"><span><pb-i18n key="edition.translator">Translator</pb-i18n></span>: [[translators]]</p></pb:template>
            </model>
        </modelSequence>
                    <modelSequence predicate="$parameters?header='metadata-all'">
            <model behaviour="pass-through">
                <param name="content" value="let $source := ext-html:get-source(ext-html:get-tale-id(parent::TEI)) let $bibl:= $source/descendant::sourceDesc/bibl return string-join(($bibl/publisher, $bibl/date), ', ')"/>
                <pb:template xmlns="" xml:space="preserve"><p class="metadata-p"><span><pb-i18n key="edition.source">Source edition</pb-i18n></span>: [[content]]</p></pb:template>
            </model>
            <model behaviour="pass-through">
                <param name="versions" value="let $versions := ext-html:get-versions-metadata(ext-html:get-tale-id(parent::TEI)) return string-join(( for $lang in distinct-values($versions?language) let $dates := for $x in $versions return $x[?language = $lang]?origDate let $formatted:= $lang || ' (' || string-join($dates, ', ') ||  ')' return $formatted), '; ')"/>
                <pb:template xmlns="" xml:space="preserve"><p class="metadata-p"><span><pb-i18n key="edition.versions">Available versions</pb-i18n></span>: [[versions]]</p></pb:template>
            </model>
            <model behaviour="pass-through">
                <param name="translators" value="let $translations := ext-html:get-versions-metadata(ext-html:get-tale-id(parent::TEI)) let $formatted := for $map in $translations where exists($map?translator) return $map?translator || ' (' || $map?language || ', ' || $map?origDate || ')' return string-join($formatted, '; ')"/>
                <pb:template xmlns="" xml:space="preserve"><p class="metadata-p"><span><pb-i18n key="edition.translators">Translators</pb-i18n></span>: [[translators]]</p></pb:template>
            </model>
        </modelSequence>
                    <model output="latex" behaviour="metadata"/>
                    <model output="fo" behaviour="omit"/>
                    <model output="web" predicate="$parameters?header='short'" behaviour="block"/>
                    <model output="web" behaviour="metadata"/>
                </elementSpec>
            <elementSpec ident="ab" mode="change">
                    <model behaviour="inline" cssClass="paragraph"/>
                </elementSpec>
            <elementSpec ident="p" mode="change">
                    <model predicate="s[@type eq 'nextParagraph']" behaviour="paragraph" cssClass="surplus"/>
                    <model predicate="preceding-sibling::p[1][@type eq 'nextParagraph']" behaviour="paragraph" cssClass="incomplete"/>
                    <model behaviour="paragraph" useSourceRendition="true">
            <outputRendition xml:space="preserve">
            text-align: justify;
            </outputRendition>
        </model>
                </elementSpec>
                <elementSpec ident="s" mode="add">
                    <model predicate="@type eq 'nextParagraph'" behaviour="inline" cssClass="nextParagraph"/>
                </elementSpec>
            </schemaSpec>
        </body>
    </text>
</TEI>